# =============================================================
# MediCOR AI — backend configuration template
#
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Every value below is a PLACEHOLDER — do not paste live
# credentials into this file. See SECURITY-ROTATION.md.
# =============================================================

# -------------------------------------------------------------
# SQL Server (required — this is the only supported database)
# -------------------------------------------------------------
DB_SERVER=your-sql-server.example.net
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=REPLACE_ME
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
# Set to false once a proper CA-signed certificate is in place.
DB_TRUST_SERVER_CERTIFICATE=true

# Windows authentication instead of DB_USER/DB_PASSWORD.
#
# A SQL Server Express instance installed with the defaults is
# Windows-auth-only with `sa` disabled, so a SQL login cannot connect to
# it at all. Set this to true to run against one without switching the
# server to mixed mode. Leave DB_USER/DB_PASSWORD blank when it is on.
#
# Only works where the app runs as a principal the server trusts — a
# local or domain machine, never a container on another host.
DB_TRUSTED_CONNECTION=false

# -------------------------------------------------------------
# Auth (required)
# -------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every live session. See SECURITY-ROTATION.md.
SECRET_KEY=REPLACE_ME_WITH_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------------------------------------------------
# Environment
# -------------------------------------------------------------
# "development" (default) or "production".
#
# Setting this to production turns four checks on (app/deployment.py). It
# is the last switch to flip, not the first: every one of them is a value
# that is CORRECT below and wrong once deployed, so the API refuses to
# start until they are right. Two are fatal, two warn:
#
#   SECRET_KEY        fatal    must not be the placeholder
#   CORS_ORIGINS      fatal    must not be localhost (see below)
#   PUBLIC_BASE_URL   warning  needed for inbound patient replies
#   TRUSTED_PROXY_IPS warning  needed only if a proxy is in front
#
# It also hides /docs, /redoc and /openapi.json, and skips the one-time
# demo-call reconciliation in app/main.py.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Where the dashboard is served from. Comma-separated, no trailing slash,
# scheme included.
#
# PRODUCTION: this must be the real URL — e.g. https://app.your-clinic.com
# The value below is four development ports and the API will refuse to
# start on it with ENVIRONMENT=production, because leaving it would break
# two things silently: the browser blocks every API call (which looks like
# a login that does nothing, not like an error), and staff invitations and
# password-reset emails are built from the FIRST origin in this list, so
# they would go out in the clinic's name carrying a link to localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------
# Payments (Razorpay) -- HV-5
# -------------------------------------------------------------
# All blank by default, which is a SUPPORTED state, not a broken one:
# POST /billing/checkout answers 503 with a plain message and the Billing
# page says online payment is not switched on. Plans are then assigned by
# a super admin, exactly as they were before payments existed.
#
# NEVER commit real values. Test keys (rzp_test_...) and live keys
# (rzp_live_...) have the same shape, so the only thing separating a
# sandbox from real money is which one is pasted here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# A DIFFERENT secret, generated when you create the webhook in the
# Razorpay dashboard. Checkout signatures are keyed by the key secret;
# webhook signatures are keyed by this one. Swapping them fails every
# verification in a way that looks like a broken integration.
#
# Point the webhook at   POST {PUBLIC_BASE_URL}/webhooks/razorpay
# and subscribe to       payment.captured, payment.failed
#
# This is the AUTHORITATIVE path. Without it a clinic that pays and then
# closes the tab is charged and never upgraded, because the browser
# callback never arrives.
RAZORPAY_WEBHOOK_SECRET=

# ISO 4217. `monthly_price_cents` is minor units, so 9900 is Rs 99.00
# with INR. Served to the pricing page and the checkout so neither has
# to hardcode a symbol.
BILLING_CURRENCY=INR

# The same idea as VOICE_MOCK_MODE: replaces exactly the paid service and
# leaves the order record, signature verification, fulfilment, the
# invoice and the subscription real. It is how the flow is proved before
# an account exists. A deployment left in it completes checkouts and
# grants plans WITHOUT TAKING ANY MONEY, so it is reported as a startup
# problem. Never true in production.
RAZORPAY_MOCK_MODE=false

# -------------------------------------------------------------
# How people reach a person
# -------------------------------------------------------------
# Shown on the public contact page and on the dashboard's Support page.
# BOTH ARE BLANK ON PURPOSE and nothing invents a placeholder: the "Call
# us" card offers a tel: link only when a number is set here, and falls
# back to the message form when it is not. A placeholder on a public page
# is worse than nothing -- somebody dials it.
#
# Same reasoning as EMERGENCY_NUMBER in voice-agent/.env: a phone number
# is a fact about the business, so it is configuration, not code.
SUPPORT_PHONE=
SUPPORT_EMAIL=
# Free text shown beside the number, so nobody rings at 3am expecting an
# answer. e.g. "Mon-Fri, 9am-6pm IST"
SUPPORT_HOURS=

# The public contact form writes to `contact_enquiries` and is reachable
# by anyone, so it is rate limited per IP like every other public write.
# Five an hour is generous for a person and useless for a spammer.
CONTACT_RATE_LIMIT_ATTEMPTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# -------------------------------------------------------------
# Reverse proxy / client IP resolution
# -------------------------------------------------------------
# Comma-separated IPs (or CIDRs) of reverse proxies you actually run in
# front of this API — e.g. nginx, an ALB, Cloudflare egress ranges.
#
# X-Forwarded-For is ONLY honoured when the direct peer is in this list.
# Leave EMPTY when the API is reached directly: an empty list means the
# header is ignored entirely, which is the safe default (an attacker can
# otherwise forge it to bypass login rate limiting).
#
# If you DO run behind a proxy and leave this empty, every client will
# appear to share the proxy's IP and will share one rate-limit bucket.
TRUSTED_PROXY_IPS=

# -------------------------------------------------------------
# Database pool
# -------------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# Legacy bootstrap: create tables and add missing columns at startup.
# Leave `true` until Alembic owns the schema in every environment, then
# set to `false`. See alembic/README.md.
AUTO_CREATE_SCHEMA=true

# -------------------------------------------------------------
# AI call analysis (Groq, OpenAI-compatible API)
# -------------------------------------------------------------
# Upgrades each finished call's summary, sentiment and outcome with an LLM,
# and answers knowledge-base questions. Leave GROQ_API_KEY empty to run with
# the rule-based summaries only -- nothing else breaks. Get a key at
# https://console.groq.com. The model must exist on your key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# -------------------------------------------------------------
# Scheduled jobs (in-process; no Redis/Celery needed)
# -------------------------------------------------------------
# All optional. Defaults shown. Automatic quality evaluation is OFF by
# default because every evaluated call is a paid LLM request.
# SCHEDULER_ENABLED=true
# APPOINTMENT_REMINDERS_ENABLED=true
# WEEKLY_DIGEST_ENABLED=true
# QUALITY_AUTO_EVAL_ENABLED=false

# -------------------------------------------------------------
# Auth hardening
# -------------------------------------------------------------
MIN_PASSWORD_LENGTH=8
# Per-IP throttle (all login attempts, successful or not).
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Per-account throttle (consecutive FAILED attempts for one email address,
# across every source IP). Cleared on a successful login.
LOGIN_ACCOUNT_RATE_LIMIT_ATTEMPTS=8
LOGIN_ACCOUNT_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# -------------------------------------------------------------
# Voice agent — multi-tenant routing (Phase 2)
# -------------------------------------------------------------
# Shared secret the voice-agent worker presents (as X-Platform-Key) to
# POST /agent/resolve-tenant, which maps a dialled number to the clinic
# that owns it. Must match BACKEND_PLATFORM_KEY in voice-agent/.env.
#
# This is a PLATFORM credential: it can resolve ANY clinic. Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Leave EMPTY to disable tenant routing entirely — the agent then uses its
# single BACKEND_API_KEY for every call, exactly as before Phase 2. That
# is the rollback switch.
AGENT_PLATFORM_KEY=

# Lifetime of the org-scoped token handed to the agent. Only needs to
# outlive one phone call.
AGENT_TOKEN_EXPIRE_MINUTES=120
AGENT_RESOLVE_RATE_LIMIT_ATTEMPTS=120
AGENT_RESOLVE_RATE_LIMIT_WINDOW_SECONDS=60

# -------------------------------------------------------------
# Scheduling
# -------------------------------------------------------------
# Maximum open slots returned by GET /appointments/availability for one
# doctor-day. Must be high enough to cover a full working day at the
# doctor's slot length, or afternoon availability becomes invisible.
AVAILABILITY_MAX_SLOTS=32

# -------------------------------------------------------------
# Outbound EHR HTTP client
# -------------------------------------------------------------
EHR_HTTP_TIMEOUT_SECONDS=8.0
EHR_HTTP_MAX_RETRIES=2
EHR_HTTP_RETRY_BACKOFF_SECONDS=0.5

# -------------------------------------------------------------
# Patient notifications (all optional — a channel with no settings
# is silently skipped, never an error)
# -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MediCOR Clinic
SMTP_USE_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=

# --- Contact consent (PF-05) ------------------------------------------
# What an unrecorded consent means. Patient.contact_consent is tri-state:
# granted, declined, or NULL for "nobody ever asked" -- which is what
# every patient row created before this feature holds.
#
# false (the default) is the cautious reading: an unasked patient is not
# messaged. A clinic that collected consent by other means (a paper
# registration form) can set this true and have its existing roster
# reachable without backfilling an answer nobody gave.
CONTACT_UNASKED_IS_CONSENT=false

# --- Patient self-service link (PF-06) --------------------------------
# Base URL of the patient-facing site, used to build the link that goes
# into an appointment message. Leave it unset and no link is included --
# the message still sends, it simply asks the patient to call instead.
# A link to a host that does not exist is worse than no link, so this is
# never guessed.
# PATIENT_LINK_BASE_URL=https://clinic.example.com

# --- SMS and inbound replies (PF-04 / PF-07) --------------------------
# SMS uses the SAME Twilio account and credentials as WhatsApp above --
# the only difference is that neither number carries the "whatsapp:"
# prefix. Set a sender to enable it.
# SMS_FROM_NUMBER=+15551234567
# Which channel a patient gets when their record does not say.
# DEFAULT_MESSAGE_CHANNEL=whatsapp
#
# Inbound replies (CONFIRM / CANCEL / STOP). Point Twilio's "A message
# comes in" webhook at  POST {PUBLIC_BASE_URL}/messages/inbound
#
# PUBLIC_BASE_URL is the URL Twilio calls, and signature verification
# hashes exactly that. Behind a proxy the URL this process sees is NOT
# the one Twilio signed, so set this or every signature fails.
# PUBLIC_BASE_URL=https://api.clinic.example.com

# --- Automatic missed-call outreach (PF-12) ---------------------------
# Messages patients whose call failed, after giving staff first refusal.
# On by default, but nothing is sent until a transport above is set up.
# MISSED_CALL_OUTREACH_ENABLED=true
# MISSED_CALL_OUTREACH_DELAY_MINUTES=30
# MISSED_CALL_OUTREACH_MAX_AGE_HOURS=24

# --- Patient feedback (PF-10) -----------------------------------------
# Asks recent callers to rate the call 1-5 by reply. OFF by default:
# every other message is something the patient needs, this one is
# something the clinic wants.
# FEEDBACK_REQUESTS_ENABLED=false
# FEEDBACK_REQUEST_COOLDOWN_DAYS=30

# --- Waiting list (PF-15) ---------------------------------------------
# Offers freed slots to patients who wanted one. On by default, but
# nothing is offered until a message transport above is configured.
# WAITING_LIST_ENABLED=true
# WAITING_LIST_OFFER_TTL_MINUTES=120
# WAITING_LIST_HORIZON_DAYS=14

# --- Post-visit follow-up (PF-14) -------------------------------------
# On by default and inert by default: nothing is sent until a clinic
# writes its own follow-up wording on the Clinic Profile page. Aftercare
# text is a clinical statement and belongs to the clinic.
# POST_VISIT_FOLLOW_UP_ENABLED=true

# --- Webhook retry (GAP-T4) -------------------------------------------
# Failed deliveries are retried with backoff, then given up on. Only
# failures are queued, so a healthy endpoint costs nothing.
# WEBHOOK_RETRY_ENABLED=true
# WEBHOOK_MAX_ATTEMPTS=4
# WEBHOOK_RETRY_BACKOFF_MINUTES=1,5,30


NOTIFICATION_HTTP_TIMEOUT_SECONDS=8.0

# -------------------------------------------------------------
# Uploads
# -------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
