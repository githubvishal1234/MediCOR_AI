# =============================================================
# MediCOR AI — voice agent configuration template
#
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# Every value below is a PLACEHOLDER. See SECURITY-ROTATION.md.
# =============================================================

# -------------------------------------------------------------
# LiveKit
# -------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME

# -------------------------------------------------------------
# Speech-to-text / text-to-speech / LLM
# -------------------------------------------------------------
# NOTE: the two stacks share several variable NAMES, and this file is
# read top to bottom -- so a duplicate further down silently wins. The
# shared ones are therefore defined ONCE, in the current-stack section
# at the bottom of this file:
#
#     DEEPGRAM_API_KEY   SARVAM_API_KEY    SARVAM_VOICE
#     SARVAM_LANGUAGE    SARVAM_TTS_MODEL  SARVAM_TTS_PACE
#     SLOW_TTS_PACE      TWILIO_PHONE_NUMBER
#
# Both stacks read them, so setting them once is correct as well as
# safer. Everything below here is LiveKit-only.

LLM_PROVIDER=groq
GROQ_API_KEY=REPLACE_ME
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=500
GROQ_TEMPERATURE=0.2

TTS_PROVIDER=sarvam
SARVAM_STT_MODEL=saaras:v3

# -------------------------------------------------------------
# SIP trunk (telephony) — Twilio Elastic SIP Trunking
# -------------------------------------------------------------
# Only these two are read by the agent at runtime (config.py):
#
#   SIP_TRUNK_ID   the LiveKit OUTBOUND trunk id. Passed straight to
#                  create_sip_participant() to dial out.
#   SIP_DOMAIN     Twilio's termination host. Used to build the transfer
#                  URI  sip:<number>@<SIP_DOMAIN>.
#
# Leave both COMMENTED OUT until the Twilio trunk exists. While unset:
#   - inbound is unaffected (it is decided by the LiveKit inbound trunk
#     and its dispatch rule, never by this file)
#   - outbound fails with a clear error instead of dialling a dead trunk
#   - transfer falls back to the tel: URI form, which agent.py handles
#
# Produced by: python setup_twilio_trunks.py --apply
#SIP_TRUNK_ID=ST_xxxxxxxxxxxx
#SIP_DOMAIN=your-subdomain.pstn.twilio.com

# --- Transfers ---------------------------------------------------------
#
# Where a caller goes when they ask for a person, when an escalation rule
# fires, when the agent judges something outside its scope, and when it
# offers a transfer after the emergency line. Read by both stacks.
#
# TWO RULES, AND THE SECOND IS EASY TO GET WRONG:
#
#   1. It must be a STAFFED line -- reception, a nurse's desk, a duty
#      mobile. Transferring to a number nobody answers is worse than
#      apologising, because the caller believes they are being helped.
#
#   2. It must NOT be the number patients dial to reach the AI. That
#      number reaches this agent, so the transfer would put the caller
#      back through to it, which would offer to transfer them again --
#      an unbounded loop, billed by the minute on both legs, with the
#      watchdog as the only thing that ends it. A clinic's "main number"
#      is exactly what somebody would paste here, which is why the
#      gateway refuses the case outright rather than trusting the
#      configuration (see _perform_transfer in bridge.py).
#
# LEAVE IT UNSET and every transfer path fails with an apology instead
# of connecting anyone. That is the safe failure and the gateway reports
# it at startup and on /health -- but it means "I want a human",
# escalation rules and the emergency transfer offer all stop working.
#DEFAULT_TRANSFER_NUMBER=+919876543210

# --- Accessibility (PF-16) --------------------------------------------
# SLOW_TTS_PACE (the pace used when a caller asks to be spoken to more
# slowly) is shared by both stacks and is set once at the bottom.

# --- Emergency handling (PF-03) ---------------------------------------
#
# READ THIS BEFORE THE LINE TAKES REAL CALLS.
#
# Spoken to a caller who describes a possible medical emergency, before
# the agent offers an immediate transfer. It outranks every other
# instruction in the prompt, and it is the highest-stakes string in the
# product. Read by BOTH voice stacks.
#
# Both values are configuration, not code, for two different reasons:
# the number is territory-specific, and the wording is a clinical
# statement that belongs to the clinic rather than to whoever last
# edited a Python file.
#
# CHOOSING THE NUMBER
#   112  India's unified national emergency number -- police, fire and
#        ambulance, everywhere in the country. The default here.
#   108  Reaches a medical ambulance directly in most states, including
#        Telangana and Andhra Pradesh. Narrower, but more direct.
#   911 US / 112 EU / 999 UK elsewhere.
#
# 112 is set because it is national, covers every kind of emergency, and
# is one number rather than a per-state decision.
#
# {number} is substituted with EMERGENCY_NUMBER. If the placeholder is
# left unset the agent says the literal words "your local emergency
# number" to somebody describing chest pain, which is why
# `test_a_configured_emergency_number_is_actually_reachable_in_the_prompt`
# fails the build when it happens.
#
# HAVE THE WORDING SIGNED OFF BY SOMEONE CLINICALLY QUALIFIED. The
# default below deliberately does NOT triage, name conditions back to
# the caller, or advise on what to do while waiting -- all three would
# be medical advice the agent is forbidden to give and not competent to
# give.
#
# ON THE FIRST REAL CALL, CHECK HOW THE NUMBER IS PRONOUNCED. Sarvam's
# enable_preprocessing normalises numbers so dosages and times sound
# natural, which can turn "112" into "one hundred and twelve". The
# prompt tells the model to say it one digit at a time; confirm that it
# does, and if not, write EMERGENCY_NUMBER as "1 1 2".
EMERGENCY_NUMBER=112
EMERGENCY_INSTRUCTION=This sounds like a medical emergency. Please hang up now and call {number}, or go straight to the nearest hospital emergency department. I can also put you through to the clinic right away if you prefer.

# -------------------------------------------------------------
# Twilio provisioning (setup_twilio_trunks.py only — never the agent)
# -------------------------------------------------------------
# These let the LiveKit trunks be created reproducibly rather than by
# hand in a dashboard. The agent never reads them.
#
# TWILIO_TERMINATION_URI      Elastic SIP Trunk termination host, e.g.
#                             medicare-xyz.pstn.twilio.com
# TWILIO_TRUNK_AUTH_USERNAME  Termination Credential List username.
# TWILIO_TRUNK_AUTH_PASSWORD  ...and its password.
# TWILIO_PHONE_NUMBER         The DID in E.164. Added to the LiveKit
#                             INBOUND trunk's `numbers` list.
# LIVEKIT_INBOUND_TRUNK_ID    Existing inbound trunk to extend. Unset
#                             means create a new one.
#
#TWILIO_TERMINATION_URI=your-subdomain.pstn.twilio.com
#TWILIO_TRUNK_AUTH_USERNAME=REPLACE_ME
#TWILIO_TRUNK_AUTH_PASSWORD=REPLACE_ME
#TWILIO_PHONE_NUMBER=+10000000000
#LIVEKIT_INBOUND_TRUNK_ID=

# -------------------------------------------------------------
# Backend API
# -------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000

# Service API key for THIS clinic org. Generate from the dashboard
# (EHR Integration -> API Keys -> Create API Key), or run
# `python create_service_api_key.py` from the backend folder.
#
# Only ONE BACKEND_API_KEY line may be active. When rotating, replace
# the value on this line — do not append a second line, or the agent
# keeps sending a stale key and gets 401s from get_org_context().
#
# NOTE: this key binds the agent to exactly one organization. To serve
# multiple clinics from one worker, set BACKEND_PLATFORM_KEY below —
# this key is then only the fallback for unassigned numbers.
BACKEND_API_KEY=REPLACE_ME

BACKEND_API_TIMEOUT_SECONDS=8
BACKEND_API_MAX_RETRIES=2
BACKEND_API_RETRY_BACKOFF_SECONDS=0.4

# -------------------------------------------------------------
# Multi-tenant routing (Phase 2)
# -------------------------------------------------------------
# With this set, the agent asks the backend which clinic owns the number
# each caller dialled, and acts as that clinic for the call. One worker
# then serves every clinic on the platform, and BACKEND_API_KEY above
# becomes a fallback used only when a number isn't assigned to anyone.
#
# Must match AGENT_PLATFORM_KEY on the backend. Leave unset to keep the
# single-tenant behaviour (and to roll back).
BACKEND_PLATFORM_KEY=

# How long to wait for the SIP participant to reveal the dialled number
# before falling back. This runs before the greeting, so keep it short.
# Ignored entirely when BACKEND_PLATFORM_KEY is unset.
DIALED_NUMBER_WAIT_SECONDS=1.5
DIALED_NUMBER_POLL_SECONDS=0.15



# #############################################################
# #                                                           #
# #   TWILIO + DEEPGRAM + SARVAM  --  THE CURRENT VOICE STACK  #
# #                                                           #
# #############################################################
#
# Everything ABOVE this line configures the legacy LiveKit worker
# (agent.py). Everything BELOW configures the gateway
# (voice-agent/twilio_deepgram/). They share this one file and read
# disjoint keys, so whichever stack you run finds what it needs.
#
# ONLY RUN ONE AT A TIME. Both answer the same clinic number, and each
# writes its own call log, so running both gives two records per call.
#
#   Patient -> Twilio -> Deepgram STT -> LLM -> FastAPI tools
#                                                    -> SQL Server
#                                          -> Sarvam Bulbul TTS
#                                          -> Twilio -> Patient
#
# =============================================================


# =============================================================
#  >>>>>  PASTE YOUR API KEYS HERE, AFTER YOU BUY THEM  <<<<<
# =============================================================
#
# These five lines are the ONLY ones that need a real secret. Everything
# further down already has a working default.
#
# Until they are filled in, run with VOICE_MOCK_MODE=true (see the MOCK
# MODE section) and the whole system works end to end with fake speech.
#
# NEVER commit this file once it holds real values. .gitignore already
# covers voice-agent/.env.
# -------------------------------------------------------------

# 1. TWILIO  --  https://console.twilio.com
#    Account SID + Auth Token are on the console dashboard.
#    The phone number is the one you buy under Phone Numbers.
TWILIO_ACCOUNT_SID=PASTE_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=PASTE_YOUR_TWILIO_AUTH_TOKEN_HERE
#
#    TWILIO_PHONE_NUMBER is the number you buy, in E.164. What it gates:
#      * outbound calls     impossible without it
#      * transfer caller id staff see the patient's number, not the clinic's
#      * inbound calls      completely unaffected
TWILIO_PHONE_NUMBER=PASTE_YOUR_TWILIO_NUMBER_HERE_LIKE_+919000000000

# 2. DEEPGRAM  --  https://console.deepgram.com  (speech recognition)
DEEPGRAM_API_KEY=PASTE_YOUR_DEEPGRAM_API_KEY_HERE

# 3. SARVAM  --  https://dashboard.sarvam.ai  (the Indian-English voice)
SARVAM_API_KEY=PASTE_YOUR_SARVAM_API_KEY_HERE

# 4. THE LLM  --  https://console.groq.com by default.
#    Leave VOICE_LLM_API_KEY unset to reuse GROQ_API_KEY from the
#    LiveKit section above, which is already configured.
#VOICE_LLM_API_KEY=PASTE_YOUR_LLM_API_KEY_HERE

# 5. VOICE_GATEWAY_PUBLIC_URL, in the next section. Not a secret, but
#    nothing works until it is right.


# =============================================================
#  WHICH STACK, AND WHICH ENGINE
# =============================================================

# Which telephony stack this deployment runs. The gateway refuses to
# start if these disagree with it, so a half-finished switch fails at
# startup rather than quietly on a call.
VOICE_PROVIDER=twilio
VOICE_AGENT_PROVIDER=deepgram

# Which conversation engine runs inside the gateway.
#
#   pipeline  Deepgram streaming STT -> your LLM -> Sarvam Bulbul TTS.
#             THE DEFAULT, and the reason this stack exists: Sarvam is
#             the only available voice that speaks Indian English.
#
#   agent     Deepgram's managed Voice Agent -- STT, turn-taking, LLM
#             and TTS behind one socket. Fewer moving parts, but it
#             CANNOT use Sarvam: its speak-provider list is deepgram /
#             cartesia / eleven_labs / open_ai / aws_polly. Choosing it
#             means an American or British voice.
VOICE_ENGINE=pipeline


# =============================================================
#  MOCK MODE  --  run the whole system with NO API keys
# =============================================================
#
# Replaces exactly three things with local fakes: speech recognition,
# the model, and the voice. EVERYTHING ELSE STAYS REAL -- the Twilio
# webhook and its signature check, the media stream, tenant resolution,
# the tool layer, the FastAPI backend, SQL Server and the dashboard.
#
# Use it to prove the deployment is wired up correctly BEFORE paying for
# anything. Then set it to false and paste the keys above.
#
#     VOICE_MOCK_MODE=true
#     ..\venv\Scripts\python.exe -m twilio_deepgram.run
#     ..\venv\Scripts\python.exe simulate_call.py      # a fake phone call
#
# It is reported loudly at startup and on /health, because a gateway
# left in mock mode answers real calls with a script.
VOICE_MOCK_MODE=false

# What the fake caller says, as JSON [[seconds, "text"], ...].
# Unset uses a built-in script that walks the booking flow.
#VOICE_MOCK_SCRIPT=[[3,"I want to book an appointment"],[9,"My number is 9876500001"]]
#VOICE_MOCK_LATENCY_SECONDS=0.3
#VOICE_MOCK_SPEECH_RATE=14


# =============================================================
#  GATEWAY HTTP SERVER
# =============================================================

VOICE_GATEWAY_HOST=0.0.0.0
VOICE_GATEWAY_PORT=8080
#VOICE_GATEWAY_ROUTE_PREFIX=/voice

# REQUIRED, and the first thing to check when anything is wrong.
#
# The https:// URL Twilio reaches this gateway on -- an ngrok URL in
# development, your real hostname in production. NO trailing slash.
#
# Two different failures come from getting it wrong, and neither looks
# like this setting:
#   * Twilio signs the URL it CALLED. Behind ngrok or a proxy that is
#     not the URL this process sees, so every signature fails and every
#     call is rejected -- which looks exactly like a bad auth token.
#   * The <Stream> element needs an absolute wss:// URL. Without one the
#     caller is answered and then hears silence.
#
# On the ngrok free tier this changes every restart, and it must be
# updated here AND on the Twilio number's webhook together.
#
# A LOCAL address (http://127.0.0.1:8080) is a legitimate value BEFORE
# the accounts exist: simulate_call.py works against it end to end, so
# the whole call path can be exercised without a tunnel. The gateway
# detects that case and reports it at startup and on /health, so it
# cannot quietly become the value nobody remembered to change.
VOICE_GATEWAY_PUBLIC_URL=https://your-subdomain.ngrok-free.app

# Verify X-Twilio-Signature on every webhook. Leave this true. The only
# reason to set it false is a local harness that cannot sign -- never a
# deployment, because these endpoints answer the phone and start a paid
# conversation.
TWILIO_VALIDATE_SIGNATURE=true

# NOTE: this stack does NOT use Elastic SIP Trunking. Twilio streams
# audio here over a plain websocket, so SIP_TRUNK_ID, SIP_DOMAIN and
# setup_twilio_trunks.py are LiveKit-only concerns. Point the number's
# Voice webhook at:
#
#     POST  {VOICE_GATEWAY_PUBLIC_URL}/voice/incoming


# =============================================================
#  LISTENING  --  Deepgram streaming speech-to-text
# =============================================================
#
# Twilio's 8 kHz mu-law goes to Deepgram exactly as it arrives; no
# conversion, no resampling.
#
# ENGLISH ONLY, matching the voice below. `en` and not `multi`: multi is
# the code-switching mode, worth paying for only when the agent can
# ANSWER in those languages. See the Hindi/Telugu note at the bottom.
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en
#DEEPGRAM_STT_VERSION=

# Milliseconds of silence that ends a caller's turn. Deepgram's own
# default is 10 ms, which on a phone call cuts people off between words.
DEEPGRAM_STT_ENDPOINTING_MS=300

# Backstop for a line so noisy the endpointer never sees silence.
# Without it a caller in the street can talk and never get an answer.
DEEPGRAM_STT_UTTERANCE_END_MS=1000

# Words the model must not mishear. Drug names and the clinic's own name
# are the ones that matter on this product.
#DEEPGRAM_STT_KEYTERMS=Metformin,Amlodipine,HealthLink

#DEEPGRAM_LISTEN_URL=wss://api.deepgram.com/v1/listen
#DEEPGRAM_CONNECT_TIMEOUT_SECONDS=10


# =============================================================
#  THINKING  --  the LLM
# =============================================================
#
# Any OpenAI-compatible /chat/completions endpoint. Defaults to Groq,
# which this project already runs on live calls through agent.py.
#
# Leave VOICE_LLM_API_KEY unset to reuse GROQ_API_KEY from above.
VOICE_LLM_BASE_URL=https://api.groq.com/openai/v1
VOICE_LLM_MODEL=openai/gpt-oss-20b
VOICE_LLM_TEMPERATURE=0.2
VOICE_LLM_MAX_TOKENS=500
#VOICE_LLM_TIMEOUT_SECONDS=12

# How many model/tool round trips one caller turn may take. Unbounded, a
# model that keeps asking for the same lookup holds a caller on a silent
# line and bills for it.
#VOICE_LLM_MAX_TOOL_ROUNDS=5
# Conversation messages kept before the oldest are dropped. The system
# prompt is never trimmed.
#VOICE_LLM_MAX_HISTORY_MESSAGES=40
# Provider extras merged into the request body, as JSON.
#VOICE_LLM_EXTRA_BODY={"reasoning_effort": "low"}


# =============================================================
#  SPEAKING  --  Sarvam Bulbul text-to-speech
# =============================================================
#
# WHY SARVAM AND NOT DEEPGRAM'S OWN VOICE
#
# Deepgram's Aura voices are American, British, Australian, Irish and
# Filipino English. There is no Indian-English voice. For a clinic whose
# callers are Indian that is the difference between sounding like the
# practice and sounding like an overseas call centre. Bulbul speaks
# en-IN natively -- and the same model covers Hindi and Telugu when you
# switch them on later.
#
# It is also why VOICE_ENGINE=pipeline exists: Deepgram's managed Voice
# Agent cannot use Sarvam at all.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_VOICE=anushka
SARVAM_LANGUAGE=en-IN
SARVAM_TTS_PACE=1.0

# mu-law at 8000 Hz is exactly what Twilio wants, so the audio goes from
# Sarvam to the caller with NO conversion. If your account rejects
# mu-law, set linear16 (or wav) and the gateway converts instead --
# slightly more CPU, identical audio.
SARVAM_TTS_CODEC=mulaw
SARVAM_TTS_SAMPLE_RATE=8000

# Numbers, dates and dosages read as words rather than digit by digit.
# On a clinic line that is most of what gets spoken aloud.
SARVAM_TTS_PREPROCESS=true

# bulbul:v3 only. v2 takes loudness/pitch instead, and sending the wrong
# pair for the model is a rejected config and a silent call.
#SARVAM_TTS_TEMPERATURE=0.6
#SARVAM_TTS_LOUDNESS=1.3
#SARVAM_TTS_PITCH=0.0

#SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws
#SARVAM_CONNECT_TIMEOUT_SECONDS=10

# The pace used when a caller asks to be spoken to more slowly (PF-16).
SLOW_TTS_PACE=0.75


# =============================================================
#  CONVERSATION BEHAVIOUR
# =============================================================

# Spoken if a tool call leaves the line silent this long. A booking is a
# model pass plus an HTTP round trip, which measured 3-5s of dead air on
# the old stack -- long enough that callers say "hello?". Set to 0 to
# disable.
VOICE_TOOL_FILLER_DELAY_SECONDS=1.2
VOICE_TOOL_FILLER_PHRASE=One moment.

# Hard ceiling on one call, as a runaway-cost backstop. An agent talking
# to a silent open line bills by the minute until something stops it.
VOICE_MAX_CALL_SECONDS=1800


# =============================================================
#  ADDING HINDI AND TELUGU LATER
# =============================================================
#
# The stack is English-only by decision, not by limitation -- Bulbul
# already speaks both. When English is proven on real calls, it is two
# lines and no code:
#
#     DEEPGRAM_STT_LANGUAGE=multi     # English + Hindi, code-switching
#     SARVAM_LANGUAGE=hi-IN           # or te-IN
#
# One wrinkle: Deepgram's nova-3 supports Telugu only as a dedicated
# language (`te`), never inside `multi`. So a Telugu line and an English
# line are two different phone numbers, not one bilingual agent.
#
# The prompt follows the voice automatically and needs no edit.
