# =============================================================
# MediCOR AI — frontend configuration template
#
# Copy to `.env` and adjust. Vite only exposes variables prefixed
# with VITE_ to client code.
#
# WARNING: everything here is compiled into the JavaScript bundle and
# is publicly readable. Never put a secret, API key, or credential in
# this file — the backend holds those.
# =============================================================

# Base URL of the FastAPI backend.
#
# Used by src/lib/api.js and src/lib/adminApi.js for REST calls, and by
# src/lib/ws.js for the dashboard WebSocket — ws.js derives the socket
# URL from this value by swapping http->ws, so a single setting covers
# both transports (https://... correctly becomes wss://...).
#
# Defaults to http://localhost:8000 when unset, which is the local
# `uvicorn app.main:app --port 8000` default.
#
# Whatever you set here must also appear in the backend's CORS_ORIGINS
# as seen from the browser's side, or requests are blocked.
#
# PRODUCTION: this is compiled INTO the bundle, not read at runtime, so
# it must be set at BUILD time -- setting it on the server afterwards has
# no effect. vite.config.js refuses to build with a localhost value for
# exactly that reason; the message tells you the escape hatch for a local
# preview build (ALLOW_LOCAL_API_URL=true).
VITE_API_URL=http://localhost:8000
